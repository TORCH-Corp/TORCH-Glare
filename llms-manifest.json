{
  "library": {
    "name": "torch-glare",
    "version": "2.4.0",
    "description": "A copy-in React component library (TypeScript + Radix UI + Tailwind CSS). Its CLI copies component source directly into your project — you own the code.",
    "license": "MIT",
    "homepage": "https://glare.torchcorp.com",
    "repository": "https://github.com/torch-corp/torch-glare"
  },
  "usage": {
    "model": "copy-in",
    "install": [
      "npx torch-glare@latest init",
      "npx torch-glare@latest add <Component>"
    ],
    "import": "import { <Component> } from \"@/components/<Component>\";",
    "note": "Components are copied into your project by the CLI; they are not imported from the npm package.",
    "commands": {
      "init": "create glare.json and set up Tailwind",
      "add": "copy a component and its dependencies into your project",
      "hook": "add a hook (usually pulled in automatically as a dependency)",
      "util": "add a utility (usually pulled in automatically)",
      "layout": "add a layout",
      "provider": "add a provider (e.g. ThemeProvider)",
      "update": "re-sync installed items with the latest templates"
    }
  },
  "statistics": {
    "totalComponents": 68,
    "totalHooks": 6,
    "totalProviders": 1,
    "totalUtils": 5,
    "totalLayouts": 4,
    "documentedComponents": 64,
    "docCoverage": 94.1,
    "exampleCoverage": 35.3
  },
